# Referenced by `--cov-config` in pyproject.toml's addopts. pytest-cov tolerates a
# missing file, but `coverage.Coverage(config_file='.coveragerc')` raises ConfigError,
# so its absence was a trap waiting for anyone who drove coverage directly.
[run]
source = abismal

# The runner tails its log, polls, and reaps the child on daemon threads. Without this
# every line they execute reports as uncovered.
concurrency = thread

omit =
    # Dead code: nothing imports it, components/__init__.py does not export it, and it
    # is the only consumer of solara in the package. Counting it would depress the
    # coverage delta for a file no one runs. Remove this line if it is ever revived or
    # deleted.
    abismal/gui/components/file_browser.py

[report]
exclude_also =
    # Colab- and JupyterLab-only branches. Both are ImportError-guarded on purpose and
    # neither import is available in CI, so these are unreachable there by design.
    except ImportError:
    if TYPE_CHECKING:
